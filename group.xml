<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="hikashop" method="upgrade">
 <name>Hikashop User Group After Purchase Plugin</name>
 <version>1.0</version>
 <description>This plugin enables you to change the group of a user after purchase of a product.</description>
 <author>Hikashop, Brett Vachon</author>
 <creationDate>2025-03-21</creationDate>
 <copyright>(C) 2010-2026 HIKARI SOFTWARE. Updates (C) 2025-2026 Brett Vachon.</copyright>
 <license>http://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	
  <files>
		<filename plugin="group">group.php</filename>
	</files>
	
  <params addpath="/components/com_hikashop/params">
		<param name="force_logout" type="radio" default="1" label="HIKA_FORCE_USER_LOGOUT_ON_GROUP_UPDATE" description="FORCE_USER_LOGOUT_ON_GROUP_UPDATE">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</param>
	</params>
	
  <config>
		<fields name="params" addfieldpath="/components/com_hikashop/fields">
			<fieldset name="basic">
				<field name="force_logout" type="radio" default="1" label="HIKA_FORCE_USER_LOGOUT_ON_GROUP_UPDATE" description="FORCE_USER_LOGOUT_ON_GROUP_UPDATE">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>

</extension>